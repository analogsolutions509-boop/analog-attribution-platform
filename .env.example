NODE_ENV=development
PORT=4100
DATABASE_URL=postgresql://...
REDIS_URL=redis://...
ANALOG_SITE_KEY_SECRET=replace-with-32-plus-random-chars
ANALOG_ENROLLMENT_SECRET=replace-with-32-plus-random-chars
ANALOG_PROVIDER_WEBHOOK_SECRET=replace-with-32-plus-random-chars
ANALOG_OS_WEBHOOK_URL=
ANALOG_OS_WEBHOOK_SECRET=replace-with-32-plus-random-chars
ANALOG_DASHBOARD_USERNAME=admin
ANALOG_DASHBOARD_PASSWORD=replace-with-32-plus-random-chars
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=replace-with-auth0-client-id
AUTH0_CLIENT_SECRET=replace-with-auth0-client-secret
AUTH0_SESSION_SECRET=replace-with-at-least-64-random-chars
AUTH0_APP_BASE_URL=http://localhost:4100
ANALOG_DASHBOARD_ALLOWED_EMAILS=owner@example.com
ANALOG_DASHBOARD_ALLOW_ANY_AUTH0_USER=false
TRANSCRIPTION_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_DIARIZE_MODEL=latest
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_INTELLIGENCE_MODEL=gpt-5.6-luna
R2_ACCOUNT_ID=
R2_BUCKET=analog-call-recordings
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
EVENT_MAX_BODY_BYTES=65536
RECORDING_MAX_BYTES=26214400
TELEPHONY_PROVIDER=wazo
TELEPHONY_INTERNAL_SECRET=replace-with-32-plus-random-chars
WAZO_API_URL=https://wazo.example.com
WAZO_AUTH_TOKEN=
WAZO_WEBHOOK_SECRET=replace-with-32-plus-random-chars
WAZO_CONTEXT=default
ANALOG_NOTIFICATIONS_WEBHOOK_URL=
ANALOG_NOTIFICATIONS_WEBHOOK_SECRET=replace-with-32-plus-random-chars
ANALOG_INTERNAL_NOTIFICATION_EMAIL=operations@example.com
